#!/usr/bin/env python3
"""Office dashboard feed for the tvhome "Office dashboard" screensaver.

Stdlib only. Serves, on DASH_BIND:DASH_PORT (default 0.0.0.0:8787):
  GET  /feed.json        JSON feed. Needs the read token: ?token=... or header X-Dash-Token.
  GET  /photos/<file>    Cached landscape photos (not sensitive, no token).
  POST /calendar         Replace today's calendar. Header "Authorization: Bearer <DASH_UPLOAD_TOKEN>".
  GET  /health           Liveness + section ages (no numbers, no token).

Environment (secrets are never printed or logged):
  STRIPE_AZTC_READ_KEY, STRIPE_FUZZHOST_READ_KEY   restricted read-only Stripe keys
  DASH_TOKEN          read token the TV sends
  DASH_UPLOAD_TOKEN   token for POST /calendar
  DASH_DATA           state dir (default ~/office-dash/data)
  DASH_MRR_SOURCE     auto (default) | subscriptions | trailing30
  DASH_LAT/DASH_LON   weather location (decimal degrees; weather is off until both are set)

Revenue definitions (USD only, other currencies ignored and counted in revenue.ignored_non_usd):
  * A charge counts once it is status=succeeded and captured, for amount_captured.
  * A refund counts (negative) when status is succeeded or pending, for its amount.
  * all_time = sum(counted charges) - sum(counted refunds), both accounts.
  * today    = charges created since local midnight (America/Phoenix) - refunds created since then.
  * trailing_30d = same over the last 30 days.
  * mrr      = active + past_due subscriptions (trialing excluded), each item unit_amount*quantity
               normalized to a month (day*365/12, week*52/12, month/count, year/12/count),
               minus percent_off coupons; amount_off coupons are subtracted once per billing period
               (normalized). Metered/tiered prices without unit_amount count as 0.
    DASH_MRR_SOURCE=auto shows subscription MRR when any active subscription exists, otherwise the
    trailing 30-day net revenue with label "30 DAYS".
State: all charge/refund ids are cached in DASH_DATA/stripe-<account>.json after one full scan; each
poll (60s) only lists objects created in the last 3 days (30 days every 6 h) to pick up new or late
succeeded charges and refunds.
"""
import datetime as dt
import hashlib
import json
import os
import random
import re
import threading
import time
import urllib.error
import urllib.parse
import urllib.request
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
try:
    from zoneinfo import ZoneInfo
    TZ = ZoneInfo("America/Phoenix")
except Exception:  # images without tzdata; Phoenix has no DST
    TZ = dt.timezone(dt.timedelta(hours=-7), "MST")

DATA = os.path.expanduser(os.environ.get("DASH_DATA", "~/office-dash/data"))
CONFIG_PATH = os.path.join(DATA, "config.json")
CONFIG_KEYS = ("STRIPE_AZTC_READ_KEY", "STRIPE_FUZZHOST_READ_KEY", "DASH_TOKEN", "DASH_UPLOAD_TOKEN",
               "DASH_MRR_SOURCE", "DASH_LAT", "DASH_LON")
_CONFIG = {"values": {}, "mtime": None}


def cfg(name, default=""):
    """Setting from DATA/config.json (written by POST /provision), else the environment."""
    try:
        m = os.path.getmtime(CONFIG_PATH)
        if m != _CONFIG["mtime"]:
            _CONFIG["values"], _CONFIG["mtime"] = json.load(open(CONFIG_PATH)), m
    except (OSError, ValueError):
        pass
    v = _CONFIG["values"].get(name)
    return str(v).strip() if v not in (None, "") else os.environ.get(name, default).strip()
PHOTOS = os.path.join(DATA, "photos")
UA = "OfficeDashFeed/1.0 (+https://github.com/fuzzynet/umbrel-app-store)"
ACCOUNTS = [("AZTC", "STRIPE_AZTC_READ_KEY"), ("FuzzHost", "STRIPE_FUZZHOST_READ_KEY")]
NEW_PAYMENT_WINDOW = 30 * 60
LOCK = threading.Lock()
STATE = {"weather": None, "revenue": None, "new_payments": [], "photos": [], "errors": {}}


def log(msg):
    print(time.strftime("%Y-%m-%d %H:%M:%S ") + msg, flush=True)


def now():
    return time.time()


def local_midnight(ts=None):
    d = dt.datetime.fromtimestamp(ts if ts is not None else now(), TZ)
    return int(d.replace(hour=0, minute=0, second=0, microsecond=0).timestamp())


def year_start(ts=None):
    d = dt.datetime.fromtimestamp(ts if ts is not None else now(), TZ)
    return int(d.replace(month=1, day=1, hour=0, minute=0, second=0, microsecond=0).timestamp())


def key_fingerprint(key):
    return hashlib.sha256(("office-dash:" + key).encode()).hexdigest()[:12]


def atomic_write(path, obj, mode=None):
    tmp = path + ".tmp"
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, mode or 0o644)
    with os.fdopen(fd, "w") as f:
        json.dump(obj, f)
    if mode:
        os.chmod(tmp, mode)
    os.replace(tmp, path)


# ---------------------------------------------------------------- Stripe
class Stripe:
    def __init__(self, name, key):
        self.name, self._key = name, key
        self.path = os.path.join(DATA, "stripe-%s.json" % name.lower())
        self.charges, self.refunds, self.meta = {}, {}, {}
        self.ignored = 0
        self.mrr_cents, self.active_subs = 0, 0
        self.fp = key_fingerprint(key)
        if os.path.exists(self.path):
            try:
                d = json.load(open(self.path))
                if d.get("meta", {}).get("key_fp", self.fp) != self.fp:
                    raise ValueError("different key")
                self.charges, self.refunds, self.meta = d["charges"], d["refunds"], d.get("meta", {})
                self.ignored = d.get("ignored_non_usd", 0)
            except Exception as e:
                log("%s: cache not usable (%s), rescanning" % (name, type(e).__name__))
                self.charges, self.refunds, self.meta = {}, {}, {}
        self.meta["key_fp"] = self.fp

    def get(self, path, params):
        q = urllib.parse.urlencode(params, doseq=True)
        req = urllib.request.Request("https://api.stripe.com/v1/%s?%s" % (path, q),
                                     headers={"Authorization": "Bearer " + self._key, "User-Agent": UA})
        for attempt in range(3):
            try:
                with urllib.request.urlopen(req, timeout=30) as r:
                    return json.load(r)
            except urllib.error.HTTPError as e:
                if e.code in (429, 500, 502, 503) and attempt < 2:
                    time.sleep(2 + attempt * 3)
                    continue
                raise RuntimeError("Stripe %s HTTP %d" % (path, e.code)) from None

    def iterate(self, path, params):
        p = dict(params, limit=100)
        while True:
            d = self.get(path, p)
            yield from d["data"]
            if not d.get("has_more") or not d["data"]:
                return
            p["starting_after"] = d["data"][-1]["id"]

    def sync(self, since=None):
        cp = {"created[gte]": since} if since else {}
        changed = False
        for c in self.iterate("charges", cp):
            if c["id"] in self.charges:
                continue
            if c.get("status") == "succeeded" and c.get("captured"):
                if c.get("currency") != "usd":
                    self.ignored += 1
                    self.charges[c["id"]] = {"t": c["created"], "a": 0, "x": "non-usd"}
                    continue
                bd = c.get("billing_details") or {}
                self.charges[c["id"]] = {"t": c["created"], "a": int(c.get("amount_captured") or c["amount"]),
                                         "c": short_name(bd.get("name")), "d": short_desc(c.get("description"))}
                changed = True
        for r in self.iterate("refunds", cp):
            if r["id"] in self.refunds or r.get("status") not in ("succeeded", "pending"):
                continue
            if r.get("currency") != "usd":
                continue
            self.refunds[r["id"]] = {"t": r["created"], "a": int(r["amount"])}
            changed = True
        if since is None:
            self.meta["full_scan"] = int(now())
        if changed or since is None:
            atomic_write(self.path, {"charges": self.charges, "refunds": self.refunds, "meta": self.meta,
                                     "ignored_non_usd": self.ignored})

    def sync_mrr(self):
        total, n = 0, 0
        for status in ("active", "past_due"):
            for s in self.iterate("subscriptions", {"status": status, "expand[]": ["data.discounts"]}):
                n += 1
                total += subscription_mrr_cents(s)
        self.mrr_cents, self.active_subs = total, n

    def totals(self, t):
        mid, d30, jan1 = local_midnight(t), t - 30 * 86400, year_start(t)
        ch, rf = self.charges.values(), self.refunds.values()
        return {
            "all_time": sum(c["a"] for c in ch) - sum(r["a"] for r in rf),
            "today": sum(c["a"] for c in ch if c["t"] >= mid) - sum(r["a"] for r in rf if r["t"] >= mid),
            "trailing_30d": sum(c["a"] for c in ch if c["t"] >= d30) - sum(r["a"] for r in rf if r["t"] >= d30),
            "ytd": sum(c["a"] for c in ch if c["t"] >= jan1) - sum(r["a"] for r in rf if r["t"] >= jan1),
        }

    def recent(self, t):
        out = []
        for cid, c in self.charges.items():
            if c["a"] > 0 and c["t"] >= t - NEW_PAYMENT_WINDOW:
                out.append({"id": cid, "amount_cents": c["a"], "account": self.name,
                            "customer": c.get("c") or "", "description": c.get("d") or "", "created_epoch": c["t"]})
        return out


def short_name(name):
    parts = (name or "").split()
    if not parts:
        return ""
    if len(parts) >= 2:
        return "%s %s." % (parts[0].title(), parts[-1][0].upper())
    return parts[0][:20]


def short_desc(desc, n=40):
    if not desc:
        return ""
    d = " ".join(desc.split())
    return d if len(d) <= n else d[: n - 1].rstrip() + "\u2026"


def monthly_factor(interval, count):
    count = max(1, int(count or 1))
    return {"day": 365.0 / 12, "week": 52.0 / 12, "month": 1.0, "year": 1.0 / 12}.get(interval, 0.0) / count


def subscription_mrr_cents(sub):
    """Monthly recurring value of one subscription in cents (float rounded at the end)."""
    gross = 0.0
    factor_any = 0.0
    for item in (sub.get("items") or {}).get("data", []):
        price = item.get("price") or item.get("plan") or {}
        rec = price.get("recurring") or {"interval": price.get("interval"), "interval_count": price.get("interval_count")}
        if (price.get("currency") or "usd") != "usd":
            continue
        unit = price.get("unit_amount")
        if unit is None:
            unit = price.get("amount")
        if unit is None:
            continue
        f = monthly_factor(rec.get("interval"), rec.get("interval_count"))
        factor_any = factor_any or f
        gross += float(unit) * int(item.get("quantity") or 1) * f
    coupons = []
    for d in sub.get("discounts") or []:
        if isinstance(d, dict):
            coupons.append((d.get("coupon") or (d.get("source") or {}).get("coupon")) or {})
    if not coupons and isinstance(sub.get("discount"), dict):
        coupons.append(sub["discount"].get("coupon") or {})
    net = gross
    for c in coupons:
        if not isinstance(c, dict):
            continue
        if c.get("percent_off"):
            net -= gross * float(c["percent_off"]) / 100.0
        elif c.get("amount_off") and (c.get("currency") or "usd") == "usd":
            net -= float(c["amount_off"]) * factor_any
    return int(round(max(0.0, net)))


def stripe_loop():
    by_name = {}
    last_wide, last_mrr = 0, 0
    while True:
        t0 = now()
        for name, env in ACCOUNTS:  # keys can arrive or change at runtime via POST /provision
            key = cfg(env)
            cur = by_name.get(name)
            if not key:
                by_name.pop(name, None)
            elif cur is None or cur.fp != key_fingerprint(key):
                by_name[name] = Stripe(name, key)
                last_mrr = 0
        accts = [by_name[n] for n, _ in ACCOUNTS if n in by_name]
        if not accts:
            STATE["errors"]["stripe"] = "no Stripe keys configured"
            time.sleep(10)
            continue
        try:
            for a in accts:
                if "full_scan" not in a.meta:
                    log("%s: first full scan" % a.name)
                    a.sync(None)
                    log("%s: full scan done, %d charges, %d refunds" % (a.name, len(a.charges), len(a.refunds)))
                elif t0 - last_wide > 6 * 3600:
                    a.sync(int(t0 - 30 * 86400))
                else:
                    a.sync(int(t0 - 3 * 86400))
            if t0 - last_wide > 6 * 3600:
                last_wide = t0
            if t0 - last_mrr > 15 * 60:
                for a in accts:
                    a.sync_mrr()
                last_mrr = t0
            publish_revenue(accts, t0)
            STATE["errors"].pop("stripe", None)
        except Exception as e:
            import traceback
            tb = traceback.extract_tb(e.__traceback__)[-1]
            STATE["errors"]["stripe"] = "%s %s (line %d)" % (type(e).__name__, str(e)[:120], tb.lineno)
            log("stripe error: " + STATE["errors"]["stripe"])
        time.sleep(max(5, 60 - (now() - t0)))


def publish_revenue(accts, t):
    per = {a.name: a.totals(t) for a in accts}
    tot = {k: sum(p[k] for p in per.values()) for k in ("all_time", "today", "trailing_30d", "ytd")}
    subs_mrr = sum(a.mrr_cents for a in accts)
    active = sum(a.active_subs for a in accts)
    mode = cfg("DASH_MRR_SOURCE", "auto")
    if mode == "subscriptions" or (mode == "auto" and active > 0):
        middle, label = subs_mrr, "MRR"
    else:
        middle, label = tot["trailing_30d"], "30 DAYS"
    rev = {"currency": "usd", "today_cents": tot["today"], "mrr_cents": middle, "mrr_label": label,
           "subscription_mrr_cents": subs_mrr, "active_subscriptions": active,
           "trailing_30d_cents": tot["trailing_30d"], "ytd_cents": tot["ytd"], "all_time_cents": tot["all_time"],
           "ignored_non_usd": sum(a.ignored for a in accts),
           "accounts": {n: {k + "_cents": v for k, v in p.items()} for n, p in per.items()},
           "updated_epoch": int(t)}
    recent = sorted((x for a in accts for x in a.recent(t)), key=lambda x: x["created_epoch"])[-10:]
    with LOCK:
        STATE["revenue"], STATE["new_payments"] = rev, recent


