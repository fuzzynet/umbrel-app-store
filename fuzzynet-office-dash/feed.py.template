def weather_from_openmeteo(d):
    cur, day = d["current"], d["daily"]
    return {"temp_f": round(cur["temperature_2m"]), "condition": WMO.get(int(cur["weather_code"]), "—"),
            "code": int(cur["weather_code"]), "high_f": round(day["temperature_2m_max"][0]),
            "low_f": round(day["temperature_2m_min"][0]),
            "precip_pct": int(day["precipitation_probability_max"][0] or 0), "updated_epoch": int(now())}


def weather_loop():
    while True:
        if not (cfg("DASH_LAT") and cfg("DASH_LON")):
            STATE["errors"]["weather"] = "no location (DASH_LAT/DASH_LON)"
            time.sleep(30)
            continue
        url = ("https://api.open-meteo.com/v1/forecast?latitude=%s&longitude=%s&current=temperature_2m,weather_code"
               "&daily=temperature_2m_max,temperature_2m_min,precipitation_probability_max"
               "&temperature_unit=fahrenheit&timezone=America%%2FPhoenix&forecast_days=1"
               % (float(cfg("DASH_LAT")), float(cfg("DASH_LON"))))
        try:
            with urllib.request.urlopen(urllib.request.Request(url, headers={"User-Agent": UA}), timeout=20) as r:
                w = weather_from_openmeteo(json.load(r))
            with LOCK:
                STATE["weather"] = w
            STATE["errors"].pop("weather", None)
            time.sleep(15 * 60)
        except Exception as e:
            STATE["errors"]["weather"] = type(e).__name__
            log("weather error: %s" % e)
            time.sleep(120)


# ---------------------------------------------------------------- Calendar
def _parse_when(v):
    """Returns (epoch or None, date or None). Accepts '2026-10-18', ISO datetimes, or Google {date|dateTime}."""
    if isinstance(v, dict):
        v = v.get("dateTime") or v.get("date")
    if not v:
        return None, None
    v = str(v).strip()
    if re.fullmatch(r"\d{4}-\d{2}-\d{2}", v):
        return None, dt.date.fromisoformat(v)
    d = dt.datetime.fromisoformat(v.replace("Z", "+00:00"))
    if d.tzinfo is None:
        d = d.replace(tzinfo=TZ)
    return int(d.timestamp()), None


def calendar_today(raw, t=None):
    t = now() if t is None else t
    today = dt.datetime.fromtimestamp(t, TZ).date()
    mid = local_midnight(t)
    nxt = mid + 86400
    out = []
    for e in raw.get("events") or raw.get("items") or []:
        if not isinstance(e, dict) or e.get("status") == "cancelled":
            continue
        if any(a.get("self") and a.get("responseStatus") == "declined" for a in e.get("attendees") or []
               if isinstance(a, dict)):
            continue
        title = short_desc(e.get("title") or e.get("summary") or "(busy)", 48)
        s_ep, s_d = _parse_when(e.get("start"))
        e_ep, e_d = _parse_when(e.get("end"))
        if s_d is not None or e.get("all_day"):
            sd = s_d or dt.datetime.fromtimestamp(s_ep, TZ).date()
            ed = e_d or (sd + dt.timedelta(days=1))
            if ed <= sd:
                ed = sd + dt.timedelta(days=1)
            if sd <= today < ed:
                out.append({"title": title, "all_day": True, "start_epoch": mid, "end_epoch": nxt})
        elif s_ep is not None:
            e_ep = e_ep or s_ep
            if s_ep < nxt and max(e_ep, s_ep + 1) > mid:
                out.append({"title": title, "all_day": False, "start_epoch": s_ep, "end_epoch": e_ep})
    out.sort(key=lambda x: (not x["all_day"], x["start_epoch"], x["title"]))
    return out


def calendar_section():
    p = os.path.join(DATA, "calendar.json")
    if not os.path.exists(p):
        return None
    try:
        raw = json.load(open(p))
        return {"date": dt.datetime.fromtimestamp(now(), TZ).date().isoformat(),
                "events": calendar_today(raw), "updated_epoch": int(raw.get("_received_epoch", os.path.getmtime(p))),
                "source": raw.get("_source", "push")}
    except Exception as e:
        log("calendar unreadable: %s" % type(e).__name__)
        return None


# ---------------------------------------------------------------- Calendar (ICS fetch)
# When AZTC_CALENDAR_ICS_URL is provisioned (POST /provision, stored in DATA/config.json, mode 600),
# the feed pulls that private iCal URL itself every 15 minutes and writes today's events to
# DATA/calendar.json in the same format the box pushes ({"events": [{title, start, end, all_day}]}).
# POST /calendar keeps working; whichever write is newest wins. The URL is never logged or shown.
ICS_EVERY = 15 * 60
CAL_STATUS = {"source": None, "last_fetch_epoch": None, "events_today": None}
_WD = {"MO": 0, "TU": 1, "WE": 2, "TH": 3, "FR": 4, "SA": 5, "SU": 6}


def _ics_lines(text):
    out = []
    for line in text.replace("\r\n", "\n").replace("\r", "\n").split("\n"):
        if line[:1] in (" ", "\t") and out:
            out[-1] += line[1:]
        elif line:
            out.append(line)
    return out


def _ics_unescape(v):
    return re.sub(r"\\([\\;,nN])", lambda m: "\n" if m.group(1) in "nN" else m.group(1), v)


def _ics_zone(name):
    if not name:
        return None
    try:
        from zoneinfo import ZoneInfo as _Z
        return _Z(name.strip('"'))
    except Exception:
        return TZ


def _ics_value(params, value):
    """Returns (datetime aware, False) or (date, True)."""
    value = value.strip()
    if params.get("VALUE") == "DATE" or re.fullmatch(r"\d{8}", value):
        return dt.date(int(value[:4]), int(value[4:6]), int(value[6:8])), True
    d = dt.datetime.strptime(value[:15], "%Y%m%dT%H%M%S")
    if value.endswith("Z"):
        d = d.replace(tzinfo=dt.timezone.utc)
    else:
        d = d.replace(tzinfo=_ics_zone(params.get("TZID")) or TZ)
    return d, False


def parse_ics(text):
    events, cur = [], None
    for line in _ics_lines(text):
        if line == "BEGIN:VEVENT":
            cur = {"exdate": [], "rdate": []}
            continue
        if line == "END:VEVENT":
            if cur is not None and "start" in cur:
                events.append(cur)
            cur = None
            continue
        if cur is None or ":" not in line:
            continue
        head, value = line.split(":", 1)
        parts = head.split(";")
        name = parts[0].upper()
        params = {}
        for p in parts[1:]:
            if "=" in p:
                k, v = p.split("=", 1)
                params[k.upper()] = v
        try:
            if name == "SUMMARY":
                cur["title"] = _ics_unescape(value)
            elif name == "UID":
                cur["uid"] = value
            elif name == "STATUS":
                cur["status"] = value.strip().upper()
            elif name in ("DTSTART", "DTEND"):
                cur["start" if name == "DTSTART" else "end"] = _ics_value(params, value)
            elif name == "DURATION":
                cur["duration"] = _ics_duration(value)
            elif name == "RRULE":
                cur["rrule"] = dict(x.split("=", 1) for x in value.split(";") if "=" in x)
            elif name in ("EXDATE", "RDATE"):
                for v in value.split(","):
                    cur[name.lower()].append(_ics_value(params, v)[0])
            elif name == "RECURRENCE-ID":
                cur["recurrence_id"] = _ics_value(params, value)[0]
        except (ValueError, KeyError):
            continue
    return events


def _ics_duration(v):
    m = re.fullmatch(r"([+-]?)P(?:(\d+)W)?(?:(\d+)D)?(?:T(?:(\d+)H)?(?:(\d+)M)?(?:(\d+)S)?)?", v.strip())
    if not m:
        raise ValueError("duration")
    w, d, h, mi, s = (int(x or 0) for x in m.groups()[1:])
    td = dt.timedelta(weeks=w, days=d, hours=h, minutes=mi, seconds=s)
    return -td if m.group(1) == "-" else td


def _add_months(d, n):
    y, m = divmod(d.month - 1 + n, 12)
    return y + d.year, m + 1


def _rrule_starts(start, rule, window_end, all_day):
    """Occurrence starts (same type as start) from start up to window_end (a date), RFC 5545 subset:
    FREQ DAILY/WEEKLY/MONTHLY/YEARLY, INTERVAL, COUNT, UNTIL, BYDAY (with +n/-n for monthly/yearly),
    BYMONTHDAY, BYMONTH. Enough for Google Calendar's recurrence options."""
    freq = rule.get("FREQ", "").upper()
    step = max(1, int(rule.get("INTERVAL", "1") or 1))
    count = int(rule["COUNT"]) if rule.get("COUNT") else None
    until = None
    if rule.get("UNTIL"):
        until = _ics_value({}, rule["UNTIL"])[0]
    sdate = start if all_day else start.date()
    byday = [(int(m.group(1) or 0), _WD[m.group(2)]) for m in
             (re.fullmatch(r"([+-]?\d+)?([A-Z]{2})", x.strip().upper()) for x in rule.get("BYDAY", "").split(",") if x.strip())
             if m and m.group(2) in _WD]
    bymd = [int(x) for x in rule.get("BYMONTHDAY", "").split(",") if x.strip()]
    bymonth = [int(x) for x in rule.get("BYMONTH", "").split(",") if x.strip()]

    def at(day):
        if all_day:
            return day
        return dt.datetime.combine(day, start.timetz().replace(tzinfo=None)).replace(tzinfo=start.tzinfo)

    def month_days(y, m):
        first = dt.date(y, m, 1)
        last = (dt.date(y + (m == 12), m % 12 + 1, 1) - dt.timedelta(days=1)).day
        days = set()
        if bymd:
            for x in bymd:
                if 1 <= abs(x) <= last:
                    days.add(x if x > 0 else last + 1 + x)
        if byday:
            for n, wd in byday:
                hits = [d for d in range(1, last + 1) if (first.weekday() + d - 1) % 7 == wd]
                if n == 0:
                    days.update(hits)
                elif abs(n) <= len(hits):
                    days.add(hits[n - 1] if n > 0 else hits[n])
        if not bymd and not byday:
            if sdate.day <= last:
                days.add(sdate.day)
        return [dt.date(y, m, d) for d in sorted(days)]

    def periods():
        i = 0
        while True:
            if freq == "DAILY":
                yield [sdate + dt.timedelta(days=i * step)]
            elif freq == "WEEKLY":
                wk = sdate - dt.timedelta(days=sdate.weekday()) + dt.timedelta(weeks=i * step)
                wds = sorted({wd for _, wd in byday}) or [sdate.weekday()]
                yield [wk + dt.timedelta(days=w) for w in wds]
            elif freq == "MONTHLY":
                y, m = _add_months(sdate, i * step)
                yield month_days(y, m)
            elif freq == "YEARLY":
                y = sdate.year + i * step
                ms = bymonth or [sdate.month]
                out = []
                for m in ms:
                    if byday or bymd:
                        out += month_days(y, m)
                    else:
                        try:
                            out.append(dt.date(y, m, sdate.day))
                        except ValueError:
                            pass
                yield out
            else:
                yield [sdate] if i == 0 else None
            i += 1

    n = 0
    for days in periods():
        if days is None:
            return
        for day in days:
            if day < sdate:
                continue
            if bymonth and freq != "YEARLY" and day.month not in bymonth:
                continue
            occ = at(day)
            if until is not None:
                if isinstance(until, dt.datetime) and not all_day:
                    if occ > until:
                        return
                elif day > (until.date() if isinstance(until, dt.datetime) else until):
                    return
            n += 1
            if count is not None and n > count:
                return
            yield occ
        if days and min(days) > window_end:
            return
        if not days and freq in ("DAILY", "WEEKLY"):
            return


def _same_occurrence(a, b):
    if isinstance(a, dt.datetime) and isinstance(b, dt.datetime):
        return a == b
    da = a.date() if isinstance(a, dt.datetime) else a
    db = b.date() if isinstance(b, dt.datetime) else b
    return da == db


def ics_events_for_day(text, day):
    """Today's events (Phoenix date `day`) as box-push-style dicts, recurring events expanded,
    EXDATEs and moved/cancelled instances (RECURRENCE-ID) applied."""
    evs = parse_ics(text)
    overrides = {}
    for e in evs:
        if "recurrence_id" in e and e.get("uid"):
            overrides.setdefault(e["uid"], []).append(e)
    out = []

    def emit(e, s, en):
        if e.get("status") == "CANCELLED":
            return
        title = e.get("title") or "(busy)"
        if isinstance(s, dt.datetime):
            out.append({"title": title, "start": s.astimezone(TZ).isoformat(), "end": en.astimezone(TZ).isoformat()})
        else:
            out.append({"title": title, "start": s.isoformat(), "end": en.isoformat(), "all_day": True})

    lo = day - dt.timedelta(days=1)
    for e in evs:
        if "recurrence_id" in e:
            s, all_day = e["start"]
        else:
            s, all_day = e["start"]
        if "end" in e:
            length = e["end"][0] - s
        elif "duration" in e:
            length = e["duration"]
        else:
            length = dt.timedelta(days=1) if all_day else dt.timedelta(0)
        if "recurrence_id" in e:
            emit(e, s, s + length)
            continue
        starts = []
        if "rrule" in e:
            try:
                for occ in _rrule_starts(s, e["rrule"], day + dt.timedelta(days=1), all_day):
                    od = occ if all_day else occ.astimezone(TZ).date()
                    if od >= lo - dt.timedelta(days=max(0, length.days)):
                        starts.append(occ)
            except Exception as ex:
                log("calendar: recurrence skipped (%s)" % type(ex).__name__)
                starts = [s]
        else:
            starts = [s]
        for r in e["rdate"]:
            if isinstance(r, type(s)):
                starts.append(r)
        ovs = overrides.get(e.get("uid"), [])
        for occ in starts:
            if any(_same_occurrence(occ, x) for x in e["exdate"]):
                continue
            if any(_same_occurrence(occ, o["recurrence_id"]) for o in ovs):
                continue
            emit(e, occ, occ + length)
    # keep only what touches `day`; calendar_today() does the final cut exactly as for pushes
    t_mid = dt.datetime.combine(day, dt.time(12), TZ).timestamp()
    return [x for x in out if calendar_today({"events": [x]}, t_mid)]


def ics_fetch_once(t=None):
    url = cfg("AZTC_CALENDAR_ICS_URL")
    if not url:
        return None
    req = urllib.request.Request(url, headers={"User-Agent": UA})
    with urllib.request.urlopen(req, timeout=30) as r:
        text = r.read(20_000_000).decode("utf-8", "replace")
    if "BEGIN:VCALENDAR" not in text:
        raise RuntimeError("not an iCal file")
    t = now() if t is None else t
    day = dt.datetime.fromtimestamp(t, TZ).date()
    events = ics_events_for_day(text, day)
    atomic_write(os.path.join(DATA, "calendar.json"),
                 {"events": events, "_received_epoch": int(t), "_source": "ics", "_date": day.isoformat()})
    CAL_STATUS.update(source="ics", last_fetch_epoch=int(t), events_today=len(events))
    return len(events)


def ics_loop():
    last_day = None
    while True:
        if not cfg("AZTC_CALENDAR_ICS_URL"):
            time.sleep(60)
            continue
        try:
            n = ics_fetch_once()
            last_day = dt.datetime.fromtimestamp(now(), TZ).date()
            STATE["errors"].pop("calendar", None)
            log("calendar: fetched iCal, %d events today" % n)
        except Exception as e:
            STATE["errors"]["calendar"] = type(e).__name__
            log("calendar fetch error: %s" % type(e).__name__)  # never the URL
            time.sleep(120)
            continue
        # sleep to the next 15-minute mark, but refetch right after local midnight
        for _ in range(ICS_EVERY // 30):
            time.sleep(30)
            if dt.datetime.fromtimestamp(now(), TZ).date() != last_day:
                break


# ---------------------------------------------------------------- Photos
COMMONS = "https://commons.wikimedia.org/w/api.php"
CATEGORIES = ["Category:Featured pictures of landscapes"]
SKIP = re.compile(r"black (&amp;|&|and) white|monochrome|b&w|night\b", re.I)


def clean_caption(title, meta):
    obj = re.sub(r"<[^>]+>", "", (meta.get("ObjectName") or {}).get("value", "")).strip()
    s = obj or title
    s = re.sub(r"^File:", "", s)
    s = re.sub(r"\.(jpe?g|png|tiff?)\Z", "", s, flags=re.I)
    s = re.sub(r"[_]+", " ", s)
    s = re.sub(r"\b(DSC|IMG|P)\s?\d+\b", "", s, flags=re.I)
    s = re.sub(r"\b\d{4}[-.]\d{2}[-.]\d{2}\b|\b\d{8}\b|\(\d+\)|\b\d{3,}\b", "", s)
    s = re.sub(r"\s*[-,]\s*\Z", "", re.sub(r"\s{2,}", " ", s)).strip(" -,")
    return short_desc(s, 48) or "Wikimedia Commons"


def commons_candidates(limit=400):
    out = []
    for cat in CATEGORIES:
        p = {"action": "query", "format": "json", "generator": "categorymembers", "gcmtitle": cat,
             "gcmtype": "file", "gcmlimit": "50", "prop": "imageinfo", "iiprop": "url|size|extmetadata|mime",
             "iiurlwidth": "1920", "iiextmetadatafilter": "ObjectName|Artist|LicenseShortName|GPSLatitude|GPSLongitude"}
        while len(out) < limit:
            req = urllib.request.Request(COMMONS + "?" + urllib.parse.urlencode(p), headers={"User-Agent": UA})
            with urllib.request.urlopen(req, timeout=30) as r:
                d = json.load(r)
            for page in (d.get("query") or {}).get("pages", {}).values():
                ii = (page.get("imageinfo") or [{}])[0]
                w, h = ii.get("width", 0), ii.get("height", 0)
                if ii.get("mime") != "image/jpeg" or w < 2400 or not h or not (1.45 <= w / h <= 1.85):
                    continue
                m = ii.get("extmetadata") or {}
                lic = (m.get("LicenseShortName") or {}).get("value", "")
                if not re.search(r"CC|Public domain|PD", lic, re.I) or "NC" in lic or "ND" in lic:
                    continue
                artist = re.sub(r"<[^>]+>", "", (m.get("Artist") or {}).get("value", "")).strip()
                artist = artist.splitlines()[0] if artist else ""
                if len(artist) > 40 or not artist:
                    artist = "Wikimedia Commons"
                if SKIP.search(page["title"] + " " + (m.get("ObjectName") or {}).get("value", "")) or SKIP.search(artist):
                    continue
                try:
                    gps = (float(m["GPSLatitude"]["value"]), float(m["GPSLongitude"]["value"]))
                except (KeyError, ValueError, TypeError):
                    gps = None
                out.append({"gps": gps, "title": page["title"], "thumb": ii.get("thumburl"), "page": ii.get("descriptionurl"),
                            "caption": clean_caption(page["title"], m),
                            "credit": short_desc("%s, %s" % (artist or "Unknown", lic), 60)})
            if "continue" not in d:
                break
            p.update(d["continue"])
    return out


def place_from_nominatim(addr):
    """'Isle of Skye, Scotland'-style caption from a Nominatim address dict."""
    country = addr.get("country", "")
    region = addr.get("state") or addr.get("region") or addr.get("province") or addr.get("archipelago") or ""
    local = addr.get("island") or addr.get("national_park") or addr.get("county") or ""
    if addr.get("country_code") in ("us", "gb") and region:
        country, region = region, local
    parts = [p for p in (region, country) if p]
    return short_desc(", ".join(parts), 48)


def place_name(lat, lon):
    url = ("https://nominatim.openstreetmap.org/reverse?format=jsonv2&zoom=8&accept-language=en&lat=%s&lon=%s"
           % (lat, lon))
    try:
        time.sleep(1.1)  # Nominatim policy: at most 1 request per second
        with urllib.request.urlopen(urllib.request.Request(url, headers={"User-Agent": UA}), timeout=20) as r:
            return place_from_nominatim(json.load(r).get("address") or {})
    except Exception:
        return ""


def photo_loop(target=40):
    os.makedirs(PHOTOS, exist_ok=True)
    idx_path = os.path.join(PHOTOS, "index.json")
    while True:
        try:
            idx = json.load(open(idx_path)) if os.path.exists(idx_path) else []
            idx = [p for p in idx if os.path.exists(os.path.join(PHOTOS, p["file"]))]
            with LOCK:
                STATE["photos"] = idx
            if len(idx) < target:
                have = {p["title"] for p in idx}
                cands = [c for c in commons_candidates() if c["title"] not in have and c["thumb"]]
                random.shuffle(cands)
                cands.sort(key=lambda c: c["gps"] is None)  # photos with a known place first
                per_artist = {}
                for p in idx:
                    a = p["credit"].rsplit(",", 1)[0]
                    per_artist[a] = per_artist.get(a, 0) + 1
                picked = []
                for c in cands:  # at most 3 photos per photographer, for variety
                    a = c["credit"].rsplit(",", 1)[0]
                    if per_artist.get(a, 0) < 3 and len(picked) < target - len(idx):
                        per_artist[a] = per_artist.get(a, 0) + 1
                        picked.append(c)
                for c in picked:
                    if c["gps"]:
                        c["caption"] = place_name(*c["gps"]) or c["caption"]
                    fn = hashlib.md5(c["title"].encode()).hexdigest()[:8] + ".jpg"
                    req = urllib.request.Request(c["thumb"], headers={"User-Agent": UA})
                    with urllib.request.urlopen(req, timeout=60) as r, open(os.path.join(PHOTOS, fn), "wb") as f:
                        f.write(r.read())
                    idx.append({"file": fn, "title": c["title"], "caption": c["caption"], "credit": c["credit"],
                                "page": c["page"]})
                    atomic_write(idx_path, idx)
                    with LOCK:
                        STATE["photos"] = list(idx)
                    time.sleep(1)
                log("photos: %d cached" % len(idx))
            STATE["errors"].pop("photos", None)
            time.sleep(24 * 3600)
        except Exception as e:
            STATE["errors"]["photos"] = type(e).__name__
            log("photo error: %s" % e)
            time.sleep(600)


# ---------------------------------------------------------------- Provisioning
# POST /provision lets the admin box push secrets without anyone pasting them. The body is
#   {"payload": base64(JSON), "sig": base64(RSA PKCS#1 v1.5 SHA-256 signature of the payload bytes)}
# and the payload is {"ts": epoch, "nonce": "...", "config": {KEY: value, ...}}. The signature must
# verify against DASH_PROVISION_KEY ("rsa:<e>:<modulus hex>", a public key, safe to publish), ts must
# be within 5 minutes and the nonce unused. Accepted keys are written to DATA/config.json (mode 600).
_SHA256_PREFIX = bytes.fromhex("3031300d060960864801650304020105000420")
_NONCES = {}


def parse_public_key(spec):
    kind, e, n = spec.strip().split(":")
    if kind != "rsa":
        raise ValueError("unsupported key")
    return int(e), int(n, 16)


def rsa_verify(spec, message, sig):
    e, n = parse_public_key(spec)
    k = (n.bit_length() + 7) // 8
    if len(sig) != k:
        return False
    m = pow(int.from_bytes(sig, "big"), e, n).to_bytes(k, "big")
    digest = _SHA256_PREFIX + hashlib.sha256(message).digest()
    expected = b"\x00\x01" + b"\xff" * (k - 3 - len(digest)) + b"\x00" + digest
    import hmac
    return hmac.compare_digest(m, expected)


def apply_provision(body, t=None):
    """Returns (http_code, response dict). Writes config.json on success."""
    import base64
    t = now() if t is None else t
    spec = os.environ.get("DASH_PROVISION_KEY", "").strip()
    if not spec:
        return 403, {"error": "provisioning disabled (no DASH_PROVISION_KEY)"}
    try:
        payload = base64.b64decode(body["payload"], validate=True)
        sig = base64.b64decode(body["sig"], validate=True)
    except Exception:
        return 400, {"error": "bad body"}
    if not rsa_verify(spec, payload, sig):
        return 401, {"error": "signature"}
    try:
        p = json.loads(payload)
        ts, nonce, conf = int(p["ts"]), str(p["nonce"]), p["config"]
    except Exception:
        return 400, {"error": "bad payload"}
    if abs(t - ts) > 300:
        return 401, {"error": "stale"}
    for k_, v in list(_NONCES.items()):
        if v < t - 600:
            del _NONCES[k_]
    if nonce in _NONCES or len(nonce) < 16:
        return 401, {"error": "replay"}
    _NONCES[nonce] = t
    if not isinstance(conf, dict) or set(conf) - set(CONFIG_KEYS):
        return 400, {"error": "unknown keys", "allowed": list(CONFIG_KEYS)}
    current = {}
    if os.path.exists(CONFIG_PATH):
        try:
            current = json.load(open(CONFIG_PATH))
        except ValueError:
            pass
    current.update({k_: str(v) for k_, v in conf.items() if v not in (None, "")})
    current["_provisioned_epoch"] = int(t)
    atomic_write(CONFIG_PATH, current, mode=0o600)
    log("provisioned: %s" % ", ".join(sorted(conf)))  # names only, never values
    return 200, {"ok": True, "stored": sorted(conf)}


